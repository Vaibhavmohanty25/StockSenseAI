DJANGO_SETTINGS_MODULE=stocksense.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=stocksense
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MARKET_DATA_PROVIDER=mock
MARKET_DATA_HTTP_TIMEOUT_SECONDS=10
MARKET_DATA_RETRY_ATTEMPTS=3
MARKET_DATA_RETRY_BACKOFF_SECONDS=0.25
# Required only when MARKET_DATA_PROVIDER=bse. Use the official licensed BSE endpoint.
BSE_API_BASE_URL=
BSE_API_KEY=
LOG_LEVEL=INFO
